{
  "name": "agent-harness",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "node scripts/run-checks.mjs",
    "dev": "turbo run dev",
    "docs:list": "node scripts/docs-list.mjs",
    "docs:check": "node scripts/docs-list.mjs --check",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "hooks:install": "node scripts/install-hooks.mjs",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "preinstall": "node scripts/install-hooks.mjs --migrate-only",
    "prepare": "node scripts/install-hooks.mjs",
    "quality": "biome check .",
    "quality:ci": "biome ci .",
    "quality:fix": "biome check --write .",
    "quality:policy": "node scripts/check-quality-policy.mjs",
    "quality:staged": "biome check --write --staged --no-errors-on-unmatched",
    "skills:validate": "node scripts/validate-skills.mjs",
    "start": "turbo run start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:packages": "turbo run test",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "lefthook": "2.1.10",
    "turbo": "^2.x",
    "typescript": "^5.x",
    "vitest": "4.1.10"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
