# Copy this file to `.env` and fill in your values:
#   cp .env.example .env

# ------------------------------------------------------------------
# LLM provider credentials
# ------------------------------------------------------------------
# By default the app talks to an OpenAI-compatible endpoint
# (https://opencode.ai/zen/go/v1) and reads the key from OPENCODE_API_KEY.
# You can use ANY OpenAI-compatible or Anthropic-compatible provider —
# see "Using any LLM provider" in README.md.
#
# OPENCODE_API_KEY=your-opencode-go-key
# OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key

# Name of the environment variable that holds your provider's API key
# (defaults to OPENCODE_API_KEY). Point this at whichever variable you set above.
# API_KEY_ENV=OPENAI_API_KEY

# Base URL for your provider. OpenAI-compatible and Anthropic-compatible
# endpoints are supported. Defaults to https://opencode.ai/zen/go/v1
# PROVIDER_ENDPOINT=https://api.openai.com/v1

# Default model for new agents
# DEFAULT_MODEL=opencode-go/qwen3.7-plus

# Process-wide cap for concurrent parent and worker agent executions
# MAX_CONCURRENT_AGENTS=10

# The server is loopback-only by default. Deliberately change both HOST and
# CORS_ORIGINS when exposing it to another machine or browser origin.
# HOST=127.0.0.1
# PORT=3001
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Privileged agent tools are disabled unless explicitly enabled. Shell commands
# retain all permissions of the harness OS account; web fetch requires egress.
# ENABLE_RUN_COMMAND=false
# ENABLE_WEB_FETCH=false

# Optional absolute directory containing plugin manifests. By default, the
# server discovers dashboard plugins from packages/dashboard/src/plugins.
# PLUGINS_DIR=E:\Projects\agent-harness\packages\dashboard\src\plugins

# ------------------------------------------------------------------
# Optional: Gemini TTS for voice output
# ------------------------------------------------------------------
# GEMINI_API_KEY=your-gemini-api-key
