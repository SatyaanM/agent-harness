# Copy this file to `.env` and fill in your values:
#   cp .env.example .env

# ------------------------------------------------------------------
# LLM provider credentials
# ------------------------------------------------------------------
# By default the app talks to an OpenAI-compatible endpoint
# (https://opencode.ai/zen/go/v1) and reads the key from OPENCODE_API_KEY.
# You can use ANY OpenAI-compatible or Anthropic-compatible provider —
# see "Using any LLM provider" in README.md.
#
# OPENCODE_API_KEY=your-opencode-go-key
# OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key

# Name of the environment variable that holds your provider's API key
# (defaults to OPENCODE_API_KEY). Point this at whichever variable you set above.
# API_KEY_ENV=OPENAI_API_KEY

# Base URL for your provider. OpenAI-compatible and Anthropic-compatible
# endpoints are supported. Defaults to https://opencode.ai/zen/go/v1
# PROVIDER_ENDPOINT=https://api.openai.com/v1

# Default model for new agents
# DEFAULT_MODEL=opencode-go/qwen3.7-plus

# ------------------------------------------------------------------
# Optional: Gemini TTS for voice output
# ------------------------------------------------------------------
# GEMINI_API_KEY=your-gemini-api-key
