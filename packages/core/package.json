    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.16",
    "@ai-sdk/openai": "^4.0.16",
    "ai": "^7.0.31",
    "fast-glob": "^3.x",
    "fs-extra": "catalog:",
    "gray-matter": "catalog:",
    "uuid": "^14.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/fs-extra": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
